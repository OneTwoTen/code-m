# Local stdio mode (default for local coding agents).
CODEM_TRANSPORT=stdio
CODEM_WORKSPACE_ROOT=.

# Production HTTP mode. Set all four values for a public deployment.
# CODEM_TRANSPORT=http
# CODEM_PUBLIC_URL=https://codem.example.com
# CODEM_SECRET_KEY=replace-with-a-long-random-application-secret
# CODEM_SETUP_TOKEN=replace-with-a-separate-bootstrap-token

# Persistent application state. Mount this directory as a volume.
CODEM_DATA_DIR=/data

# SQLite is the implemented adapter. Empty means file:${CODEM_DATA_DIR}/codem.sqlite.
CODEM_DATABASE_URL=

# HTTP listener and outbound request settings.
CODEM_HTTP_HOST=0.0.0.0
CODEM_HTTP_PORT=3000
CODEM_OUTBOUND_HTTP_TIMEOUT_MS=10000

# Remote terminal remains disabled by default. Embedded OAuth does not grant codem:execute.
CODEM_ALLOW_REMOTE_TERMINAL=false

# Embedded OAuth is the default production authentication provider.
CODEM_AUTH_PROVIDER=embedded
CODEM_AUTH_SCOPES=codem:read

# Optional advanced external token-introspection provider.
# CODEM_AUTH_PROVIDER=external-oidc
# CODEM_AUTH_ISSUER=https://auth.example.com
# CODEM_AUTH_INTROSPECTION_URL=https://auth.example.com/oauth2/introspect
# CODEM_AUTH_CLIENT_ID=codem-resource-server
# CODEM_AUTH_CLIENT_SECRET=replace-with-a-secret
# CODEM_AUTH_SCOPES=codem:read codem:execute

# Optional environment-driven GitHub App configuration for automation.
# The preferred self-hosted path is the /setup wizard.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_URL=https://api.github.com
