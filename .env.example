# Local workspace CodeM is allowed to access.
CODEM_WORKSPACE_ROOT=.

# Transport: stdio for local agents, http for ChatGPT and remote MCP clients.
CODEM_TRANSPORT=stdio

# Remote HTTP settings. Required when CODEM_TRANSPORT=http.
CODEM_HTTP_HOST=0.0.0.0
CODEM_HTTP_PORT=3000
CODEM_PUBLIC_URL=https://codem.example.com
CODEM_ALLOWED_HOSTS=codem.example.com
CODEM_ALLOW_REMOTE_TERMINAL=false

# OAuth 2.1 authorization server and RFC 7662 token introspection.
CODEM_AUTH_ISSUER=https://auth.example.com
CODEM_AUTH_INTROSPECTION_URL=https://auth.example.com/oauth2/introspect
CODEM_AUTH_CLIENT_ID=codem-resource-server
CODEM_AUTH_CLIENT_SECRET=replace-with-a-secret
CODEM_AUTH_SCOPES=codem:read codem:execute

# Optional GitHub App installation connection.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_API_URL=https://api.github.com
